@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0
hide circle
hide methods

title Domain Model

' ============================================================
' OPERATORS AND ROLLING STOCK
' ============================================================

package "Operators and Rolling Stock" {

    class Operator {
        name
        shortName
        vatNumber
        country
    }

    class Locomotive {
        number
        name
        make
        model
        serviceYear
        type
        powerKw
        maxSpeedKmH
        operationalSpeedKmH
        tractionKN
        totalWeightTons
        lengthM
        widthM
        heightM
        numBogies
        bogieType
        voltage
        frequency
        fuelCapacityL
        gaugeMM
    }

    class WagonModel {
        id
        model
        maker
        numBogies
        bogieType
        lengthM
        widthM
        heightM
        tareWeightTons
        payloadTons
        maxSpeedKmH
        volumeM3
        type
        gaugeMM
    }

    class Wagon {
        number
        model
        operator
        serviceYear
        gaugeMM
    }

    class Train {
        name
        status
    }

    ' === Relationships ===
    Operator "1" -- "*" Locomotive : operates >
    Operator "1" -- "*" Wagon : operates >
    Operator "1" -- "*" Train : manages >
    WagonModel "1" -- "*" Wagon : defines >
    Train "*" -- "*" Locomotive : uses >
    Train "*" -- "*" Wagon : pulls >
}

' ============================================================
' INFRASTRUCTURE
' ============================================================

package "Infrastructure" {

    class Facility {
        id
        name
    }

    class RailwayLine {
        id
        name
        owner
        startStation
        endStation
        gaugeMM
        totalLengthKm
    }

    class LineSegment {
        id
        line
        order
        electrified
        maxWeightKgPerMeter
        lengthM
        numberTracks
    }

    class Station {
        name
        city
        hasWarehouse
    }

    class Gauge {
        name
        measureMM
    }

    ' === Relationships ===
    RailwayLine "1" -- "*" LineSegment : composed of >
    LineSegment "1" -- "1" Station : start >
    LineSegment "1" -- "1" Station : end >
    Gauge "1" -- "*" LineSegment : defines >
    Gauge "1" -- "*" Locomotive : supports >
    Gauge "1" -- "*" Wagon : supports >
}

' ============================================================
' FREIGHT AND ROUTES
' ============================================================

package "Freight and Routes" {

    class Freight {
        departureTime
        arrivalTime
        status
    }

    class FreightWagon {
        cargoDescription
        grossWeightKg
    }

    class Route {
        description
    }

    class RouteSegment {
        sequenceOrder
    }

 ' === Relationships ===
    Freight "1" -- "*" Wagon : includes >
    Freight "1" -- "*" FreightWagon : includes >
    Freight "1" -- "1" Route : follows >
    Freight "1" -- "1" Station : origin >
    Freight "1" -- "1" Station : destination >
    Wagon "1" -- "*" FreightWagon : assigned to >
    Route "1" -- "*" RouteSegment : consists of >
    RouteSegment "*" -- "1" LineSegment : references >
    Station "1" -- "*" Freight : dispatches/receives >
}

@enduml
