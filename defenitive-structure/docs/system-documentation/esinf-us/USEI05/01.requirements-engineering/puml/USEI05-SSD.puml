@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Quality Operator" as Operator
participant ":System" as System

activate Operator

    Operator -> System : requestReturnsProcessing(returnsFile)
    activate System

        System --> Operator : confirms returns file loaded and validated
    deactivate System

    Operator -> System : startQuarantineInspection()
    activate System

        System --> Operator : displays ordered list of returns (latest first)
    deactivate System

    Operator -> System : confirmInspectionStart()
    activate System

        System --> Operator : processes each return in reverse arrival order
        System --> Operator : classifies reason (customer-remorse, damaged, expired, cycle-count)
        System --> Operator : restocks or discards accordingly
        System --> Operator : inserts restocked items into warehouse (FEFO/FIFO)
        System --> Operator : writes each action to audit log file
    deactivate System

    Operator -> System : acknowledgeProcessingResults()
    activate System

        System --> Operator : displays summary (restocked, discarded, errors)
        System --> Operator : confirms audit log file generated (Logs/audit_log.txt)
    deactivate System

    Operator -> System : confirmOperationSuccess()
    activate System

        System --> Operator : displays operation success or failure
    deactivate System

@enduml
