@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Warehouse Operator" as Operator
participant ":System" as System

activate Operator

Operator -> System : loadReturns(filePath)
activate System
System --> Operator : shows import summary and validation logs
deactivate System

Operator -> System : confirmQuarantineInspection()
activate System
System --> Operator : begins processing returns in reverse chronological order
deactivate System

Operator -> System : inspect each return
activate System

System --> Operator : inspects returns and shows restock/discard results
System --> Operator : writes audit entries
deactivate System

@enduml
