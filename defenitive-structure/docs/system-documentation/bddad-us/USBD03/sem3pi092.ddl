CREATE TABLE locomotive (id_locomotive number(10) GENERATED AS IDENTITY, name varchar2(255) NOT NULL, make varchar2(255) NOT NULL, service number(10) NOT NULL, number_bogies number(10) NOT NULL, bogies varchar2(255) NOT NULL, power number(10) NOT NULL, length number(10) NOT NULL, width number(10) NOT NULL, height number(10) NOT NULL, weight number(10) NOT NULL, max_speed number(10) NOT NULL, operational_speed number(10) NOT NULL, traction number(10) NOT NULL, type varchar2(255) NOT NULL, voltage number(10), frequency number(10), operator varchar2(255) NOT NULL, bitola number(10) NOT NULL, combustivel number(10), PRIMARY KEY (id_locomotive));
CREATE TABLE station (id_station number(10) GENERATED AS IDENTITY, name_station varchar2(255) NOT NULL, positionx number(10) NOT NULL, positiony number(10) NOT NULL, PRIMARY KEY (id_station));
CREATE TABLE line (id_line number(10) GENERATED AS IDENTITY, name_line varchar2(255) NOT NULL, owner varchar2(255) NOT NULL, gauge number(10) NOT NULL, start_id number(10) NOT NULL, start_name varchar2(255) NOT NULL, end_id number(10) NOT NULL, end_name varchar2(255) NOT NULL, PRIMARY KEY (id_line));
CREATE TABLE wagon_model (id_model number(10) GENERATED AS IDENTITY, model_wagon varchar2(255) NOT NULL, maker varchar2(255) NOT NULL, number_bogies number(10) NOT NULL, bogies varchar2(255) NOT NULL, lenght number(10) NOT NULL, width number(10) NOT NULL, height number(10) NOT NULL, max_speed number(10) NOT NULL, payload number(10) NOT NULL, volume number(10) NOT NULL, type varchar2(255) NOT NULL, bitola number(10) NOT NULL, PRIMARY KEY (id_model));
CREATE TABLE box (id_box number(10) GENERATED AS IDENTITY, box_sku varchar2(255) NOT NULL, quantity number(10) NOT NULL, expiry_date number(10) NOT NULL, received_at number(10) NOT NULL, bay_id number(10) NOT NULL, PRIMARY KEY (id_box));
CREATE TABLE warehouse (id_warehouse number(10) GENERATED AS IDENTITY, name_warehouse number(10) NOT NULL, number_aisles number(10) NOT NULL, PRIMARY KEY (id_warehouse));
CREATE TABLE aisles (id_aisle number(10) GENERATED AS IDENTITY, number_bays number(10) NOT NULL, PRIMARY KEY (id_aisle));
CREATE TABLE aisles_warehouse (aisle_id number(10) NOT NULL, warehouse_id number(10) NOT NULL);
CREATE TABLE bay (id_bay number(10) GENERATED AS IDENTITY, box_capacity number(10) NOT NULL, priority number(10) NOT NULL, PRIMARY KEY (id_bay));
CREATE TABLE bay_aisles (bay_id number(10) NOT NULL, aisle_id number(10) NOT NULL);
CREATE TABLE product (id_product number(10) GENERATED AS IDENTITY, product_name varchar2(255) NOT NULL, category number(10) NOT NULL, unit varchar2(255) NOT NULL, volume number(10) NOT NULL, unit_weight number(10) NOT NULL, quantity number(10) NOT NULL, PRIMARY KEY (id_product));
CREATE TABLE product_in_box (box_id number(10) NOT NULL, product_id number(10) NOT NULL);
CREATE TABLE facility (id_facility number(10) GENERATED AS IDENTITY, name number(10) NOT NULL, PRIMARY KEY (id_facility));
CREATE TABLE line_facility (id_facility_start_id number(10) NOT NULL, name_facility_start_name varchar2(255) NOT NULL, id_facility_end_id number(10) NOT NULL, name_facility_end_name varchar2(255) NOT NULL, PRIMARY KEY (id_facility_start_id, id_facility_end_id));
CREATE TABLE segment (id_segment number(10) GENERATED AS IDENTITY, line_id number(10) NOT NULL, "order" number(10) NOT NULL, eletrified raw(2000) NOT NULL, weight number(10) NOT NULL, length number(10) NOT NULL, number_tracks varchar2(255) NOT NULL, PRIMARY KEY (id_segment));
CREATE TABLE owner (id_owner number(10) GENERATED AS IDENTITY, short_name varchar2(255) NOT NULL, vatnumber varchar2(255) NOT NULL, PRIMARY KEY (id_owner));
CREATE TABLE owner_line (owner_id number(10) NOT NULL, line_id number(10) NOT NULL, owner number(10) NOT NULL, PRIMARY KEY (owner_id, line_id));
CREATE TABLE operator (Id_operator number(10) GENERATED AS IDENTITY, short_name_operator varchar2(255) NOT NULL, vatnumber_operator varchar2(255) NOT NULL, PRIMARY KEY (Id_operator));
CREATE TABLE locomotive_operator (operator_id number(10) NOT NULL, locomotive_id number(10) NOT NULL, short_name_operator number(10) NOT NULL, PRIMARY KEY (operator_id, locomotive_id));
CREATE TABLE wagon (number number(10) GENERATED AS IDENTITY, model varchar2(255) NOT NULL, operator varchar2(255) NOT NULL, service_year number(10) NOT NULL, model_id number(10) NOT NULL, PRIMARY KEY (number));
CREATE TABLE wagon_operator (operator_id number(10) NOT NULL, wagon_number number(10) NOT NULL, short_name_operator number(10) NOT NULL, PRIMARY KEY (operator_id, wagon_number));
CREATE TABLE wagon_model_wagon (model_id number(10) NOT NULL, wagon_id number(10) NOT NULL, model number(10) NOT NULL, PRIMARY KEY (model_id, wagon_id));
