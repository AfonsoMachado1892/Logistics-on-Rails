ALTER TABLE wagon_model_wagon ADD CONSTRAINT FKwagon_mode404251 FOREIGN KEY (model_id) REFERENCES wagon_model (id_model);
ALTER TABLE wagon_model_wagon ADD CONSTRAINT FKwagon_mode401828 FOREIGN KEY (wagon_id) REFERENCES wagon (number);
