CREATE TABLE locomotive (id_locomotive number(10) GENERATED BY DEFAULT AS IDENTITY, name varchar2(255) NOT NULL, make varchar2(255) NOT NULL, service number(10) NOT NULL, number_bogies number(10) NOT NULL, bogies varchar2(255) NOT NULL, power number(10) NOT NULL, length number(10) NOT NULL, width number(10) NOT NULL, height number(10) NOT NULL, weight number(10) NOT NULL, max_speed number(10) NOT NULL, operational_speed number(10) NOT NULL, traction number(10) NOT NULL, type varchar2(255) NOT NULL, voltage number(10), frequency number(10), operator varchar2(255) NOT NULL, bitola number(10) NOT NULL, combustivel number(10), PRIMARY KEY (id_locomotive));
CREATE TABLE station (id_station number(10) GENERATED BY DEFAULT AS IDENTITY, name_station varchar2(255) NOT NULL, positionx number(10) NOT NULL, positiony number(10) NOT NULL, PRIMARY KEY (id_station));
CREATE TABLE line (id_line number(10) GENERATED BY DEFAULT AS IDENTITY, name_line varchar2(255) NOT NULL, owner varchar2(255) NOT NULL, gauge number(10) NOT NULL, start_id number(10) NOT NULL, start_name varchar2(255) NOT NULL, end_id number(10) NOT NULL, end_name varchar2(255) NOT NULL, PRIMARY KEY (id_line));
CREATE TABLE wagon_model (id_model number(10) GENERATED BY DEFAULT AS IDENTITY, model_wagon varchar2(255) NOT NULL, maker varchar2(255) NOT NULL, number_bogies number(10) NOT NULL, bogies varchar2(255) NOT NULL, lenght number(10) NOT NULL, width number(10) NOT NULL, height number(10) NOT NULL, max_speed number(10) NOT NULL, payload number(10) NOT NULL, volume number(10) NOT NULL, type varchar2(255) NOT NULL, bitola number(10) NOT NULL, PRIMARY KEY (id_model));
CREATE TABLE facility (id_facility number(10) GENERATED BY DEFAULT AS IDENTITY, name varchar2(255) NOT NULL, PRIMARY KEY (id_facility));
CREATE TABLE line_facility (id_facility_start_id number(10) NOT NULL, name_facility_start_name varchar2(255) NOT NULL, id_facility_end_id number(10) NOT NULL, name_facility_end_name varchar2(255) NOT NULL, PRIMARY KEY (id_facility_start_id, id_facility_end_id));
CREATE TABLE segment (id_segment number(10) GENERATED BY DEFAULT AS IDENTITY, line_id number(10) NOT NULL, "order" number(10) NOT NULL, eletrified NUMBER(1) NOT NULL, weight number(10) NOT NULL, length number(10) NOT NULL, number_tracks varchar2(255) NOT NULL, PRIMARY KEY (id_segment));
CREATE TABLE owner (id_owner number(10) GENERATED BY DEFAULT AS IDENTITY, short_name varchar2(255) NOT NULL, vatnumber varchar2(255) NOT NULL, PRIMARY KEY (id_owner));
CREATE TABLE owner_line (owner_id number(10) NOT NULL, line_id number(10) NOT NULL, owner number(10) NOT NULL, PRIMARY KEY (owner_id, line_id));
CREATE TABLE operator (Id_operator number(10) GENERATED BY DEFAULT AS IDENTITY, short_name_operator varchar2(255) NOT NULL, vatnumber_operator varchar2(255) NOT NULL, PRIMARY KEY (Id_operator));
CREATE TABLE locomotive_operator (operator_id number(10) NOT NULL, locomotive_id number(10) NOT NULL, short_name_operator number(10) NOT NULL, PRIMARY KEY (operator_id, locomotive_id));
CREATE TABLE wagon (number_wagon number(10) GENERATED BY DEFAULT AS IDENTITY, model varchar2(255) NOT NULL, operator varchar2(255) NOT NULL, service_year number(10) NOT NULL, model_id number(10) NOT NULL, PRIMARY KEY (number_wagon));
CREATE TABLE wagon_operator (operator_id number(10) NOT NULL, wagon_number number(10) NOT NULL, short_name_operator number(10) NOT NULL, PRIMARY KEY (operator_id, wagon_number));
CREATE TABLE wagon_model_wagon (model_id number(10) NOT NULL, wagon_id number(10) NOT NULL, model number(10) NOT NULL, PRIMARY KEY (model_id, wagon_id));
CREATE TABLE Building (id_building number(10) GENERATED BY DEFAULT AS IDENTITY, facility_id number(10) NOT NULL, name varchar2(255) NOT NULL, building_type_id number(10) NOT NULL, PRIMARY KEY (id_building));
CREATE TABLE building_type (id_building_type number(10) GENERATED BY DEFAULT AS IDENTITY, type varchar2(255) NOT NULL, PRIMARY KEY (id_building_type));
CREATE TABLE Gauge (id_gauge number(10) GENERATED BY DEFAULT AS IDENTITY, width number(10) NOT NULL, PRIMARY KEY (id_gauge));
CREATE TABLE locomotive_Gauge (locomotive_id number(10) NOT NULL, Gauge_id number(10) NOT NULL, PRIMARY KEY (locomotive_id, Gauge_id));
CREATE TABLE Gauge_line (gauge_id number(10) NOT NULL, line_id number(10) NOT NULL, PRIMARY KEY (gauge_id, line_id));

