@startuml
skinparam monochrome true
skinparam packageStyle rectangle
hide circle
hide methods

title Domain Model

' ============================================================
' OPERATORS AND ROLLING STOCK
' ============================================================

package "Operators and Rolling Stock" {

    class Operator {
        name
        shortName
        vatNumber
        country
    }

    class LocomotiveModel {
        make
        model
        type
        powerKw
        maxSpeedKmH
        tractionKN
        totalWeightTons
        lengthM
        widthM
        heightM
        numBogies
        bogieType
        voltage
        frequency
        fuelCapacityL
    }

    class Locomotive {
        number
        name
        serviceYear
    }

    class WagonModel {
        id
        model
        maker
        numBogies
        bogieType
        lengthM
        widthM
        heightM
        tareWeightTons
        payloadTons
        maxSpeedKmH
        volumeM3
        type
    }

    class Wagon {
        number
        serviceYear
    }

    class Train {
        name
        status
        scheduleDepartureTime
    }

    class TrainEvent {
        timestamp
        eventType
    }

    Operator "1" -- "*" Locomotive : operates >
    Operator "1" -- "*" RailwayLine : owns >
    Operator "1" -- "*" Wagon : operates >
    Operator "1" -- "*" Train : manages >

    LocomotiveModel "1" -- "*" Locomotive : defines >
    WagonModel "1" -- "*" Wagon : defines >

    Train "*" -- "*" Locomotive : uses >
    Train "*" -- "*" Wagon : pulls >
    TrainEvent "1" -- "1" Station
}

' ============================================================
' INFRASTRUCTURE
' ============================================================

package "Infrastructure" {

    class Gauge {
        name
        measureMM
    }

    class Station {
        id
        name
        city
        latitude
        longitude
        country
        timeZoneGroup
        isCity
        isMainStation
        isAirport
        hasWarehouse
    }

    class Facility {
        id
        name
        type
        isIntermodal
        hasGrainSilos
        hasRefrigeratedAreas
    }

    class RailwayLine {
        id
        name
        + totalLengthKm()
    }

    class LineSegment {
        id
        order
        electrified
        maxWeightKgPerMeter
        lengthM
        numberTracks
        speedLimitKmH
    }

    Station "1" -- "*" Facility : hosts >

    RailwayLine "1" -- "*" LineSegment : composed of >
    LineSegment "1" -- "1" Station : start >
    LineSegment "1" -- "1" Station : end >

    RailwayLine "1" -- "1" Station : begins at >
    RailwayLine "1" -- "1" Station : ends at >

    Gauge "1" -- "*" LineSegment : defines >
    Gauge "*" -- "*" Locomotive : supports >
    Gauge "1" -- "*" Wagon : supports >
    Gauge "1" -- "*" RailwayLine : allowed on >
}

' ============================================================
' FREIGHT AND ROUTES
' ============================================================

package "Freight and Routes" {

    class Route {
        description
    }

    class RouteSegment {
        sequenceOrder
    }

    class Freight {
        departureTime
        arrivalTime
        status
    }

    class FreightWagon {
        cargoDescription
        grossWeightKg
    }

    Route "1" -- "*" RouteSegment : consists of >
    RouteSegment "*" -- "1" LineSegment : references >
    Freight "1" -- "1" Route : follows >
    Freight "1" -- "*" Wagon : includes >
    Freight "1" -- "*" FreightWagon : includes >
    Station "1" -- "*" Freight : dispatches/receives >
    Freight "1" -- "1" Station : origin >
    Freight "1" -- "1" Station : destination >
    FreightWagon "1" -- "1" Wagon : carried by >
}

' ============================================================
' WAREHOUSE MANAGEMENT (ESINF)
' ============================================================

package "Warehouse Management" {

    class Item {
        SKU
        name
        category
        unit
        unitWeight
        volume
    }

    class Warehouse {
        id
        name
    }

    class Aisle {
        number
        xCoord
    }

    class Bay {
        number
        yCoord
        capacityBoxes
    }

    class Box {
        boxId
        qty
        expiryDate
        receivedAt
    }

    class Order {
        orderId
        dueDate
        priority
    }

    class OrderLine {
        lineNo
        requestedQty
    }

    class Allocation {
        qty
        status
    }

    class Return {
        returnId
        SKU
        qty
        reason
        timestamp
        expiryDate
    }

    class PickBatch {
        id
        heuristic
        capacityKg
        usedWeightKg
    }

    class PickTask {
        id
        aisleCoord
        bayCoord
        qty
    }

    class PickPath {
        strategy
        totalDistance
    }

    Station "1" -- "*" Warehouse : contains >
    Warehouse "1" -- "*" Aisle : has >
    Aisle "1" -- "*" Bay : has >
    Bay "1" -- "*" Box : stores >
    Item "1" -- "*" Box : stocked as >

    Order "1" -- "*" OrderLine : contains >
    OrderLine "1" -- "*" Allocation : allocates >
    Allocation "*" -- "1" Box : taken from >
    Allocation "*" -- "1" Bay : located at >

    Return "*" -- "1" Item : refers to >
    Return "1" -- "*" Box : generates >

    PickBatch "1" -- "*" PickTask : groups >
    PickPath "1" -- "*" PickTask : sequences >
}

@enduml