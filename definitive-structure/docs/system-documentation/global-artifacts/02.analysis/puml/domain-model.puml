@startuml
skinparam monochrome true
skinparam packageStyle rectangle
hide circle
hide methods

title Domain Model


package "Infrastructure" {
    class RailwayLine {
        id
        name
        owner
        totalLengthKm
    }

    class LineSegment {
        id
        lengthKm
        trackType
        gauge
        maxWeightKgPerMeter
        speedLimitKmH
        electrified
    }

    class Gauge {
        id
        name
        measureMM
    }

    class Station {
        id
        name
        city
        latitude
        longitude
        country
        timeZone
        timeZoneGroup
        isCity
        isMainStation
        isAirport
        hasWarehouse
        hasGrainSilo
        hasRefrigeratedStorage
    }

    RailwayLine "1" -- "*" LineSegment : composed of
    Gauge "1" -- "*" LineSegment : defines
    Station "1" -- "*" LineSegment : occurs at
    Station "1" -- "*" LineSegment : start / end
}

package "Freight and Routes" {
    class Route {
        id
        description
        type
    }

    class RouteSegment {
        sequenceOrder
        estimatedArrival
        estimatedDeparture
        actualArrival
        actualDeparture
        stopAtStation
    }

    class Freight {
        id
        departureTime
        arrivalTime
        status
    }

    class CrossingOperation {
        id
        station
        estimatedTime
        trainsPriority
    }

    class FreightWagon{
        cargoDescription
        grossWeightKg
        loaded
    }

    Route "1" -- "*" RouteSegment : consists of
    Route "1" -- "*" Freight : contains
    Route "1" -- "*" CrossingOperation : requires
    RouteSegment "*" -- "1" Station : passes through
    CrossingOperation "*" -- "1" Station : occurs at
    Freight "1" -- "*" FreightWagon : includes
    Freight "*" -- "1" Station : origin
    Freight "*" -- "1" Station : destination
    Freight "*" -- "*" Station : assigned to
}

package "Operators and Rolling Stock" {
    class Operator {
        name
        country
    }

    class Train {
        id
        name
        status
        scheduledDeparture
    }

    class Locomotive {
        id
        make
        model
        year
        powerKw
        maxSpeedKmH
        tareWeightTons
        numBogies
        gauge
    }

    class ElectricLocomotive extends Locomotive {
        voltageV
        frequencyHz
    }

    class DieselLocomotive extends Locomotive {
        fuelCapacityL
    }

    class Wagon {
        id
        type
        payloadCapacityKg
        volumeM3
        tareWeightKg
        gauge
    }

    Operator "1" -- "*" Train : manages
    Operator "1" -- "*" Locomotive : owns
    Operator "1" -- "*" Wagon : owns

    Train "*" -- "*" Locomotive : uses
    Train "*" -- "*" Wagon : pulls
    Train "1" -- "1" Route : follows

    Locomotive "*" -- "1" Gauge : supports

    Wagon "*" -- "1" Freight: references
    Wagon "*" -- "1" Gauge : supports
    Wagon "1" -- "*" FreightWagon : assigned to
}

package "Warehouse Management" {
    class Inventory {
        bayCapacityBoxes
    }

    class Trolley {
        id
        capacityKg
        usedWeightKg
    }

    class MovementLog {
        timestamp
        type
        boxID
        quantity
        origin
        destination
    }

    class Allocation {
        orderID
        lineNo
        quantity
        boxID
        aisle
        bay
    }

    class ReturnsEntry {
        returnsID
        quantity
        timestamp
        reason
        expiryDate
    }

    class Coordinate {
        aisle
        bay
    }

    class Eligibility {
        orderID
        lineNo
        requiredQty
        allowedQty
        status
    }

    class Order {
        orderID
        priority
        dueDate
    }

    class Box {
        boxID
        quantity
        entryDate
        receivedAt
    }

    class Item {
        sku
        name
        category
        unit
        volume
        unitWeight
    }

    class OrderLine {
        lineNo
        quantity
    }

    class BayID {
        wharehouseID
        aisle
        bay
    }

    Station "1" -- "1" Inventory : manages

    Inventory "1" -- "*" MovementLog : logs
    Inventory "1" -- "*" Box : contains

    Trolley "1" -- "*" Allocation : carries
    Trolley "1" -- "*" Coordinate : visits

    MovementLog "*" -- "0..1" BayID : from
    MovementLog "*" -- "0..1" BayID : to
    MovementLog "*" -- "1" Box : references

    Allocation "*" -- "1" BayID : located at
    Allocation "*" -- "1" Box : references
    Allocation "*" -- "0..1" Order: allocated to

    ReturnsEntry "1" -- "1" Box : restocks as
    ReturnsEntry "*" -- "1" Item : references

    BayID "1" -- "*" Box : stored in

    Order "1" -- "*" OrderLine : contains
    Order "1" -- "*" Eligibility : evaluates

    OrderLine "*" -- "1" Item : references
    OrderLine "1" -- "*" Eligibility : evaluates

    Box "*" -- "1" Item : references
}

' Relações Inter-Pacote
RouteSegment "1" -- "1" LineSegment : follows

@enduml