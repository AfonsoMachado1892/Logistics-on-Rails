@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0
hide circle
hide methods

title Logistics on Rails - Domain Model

' Operators and Rolling Stock

package "Operators and Rolling Stock" {

    class Operator {
        name
        country
    }

    class Locomotive {
        make
        model
        year
        type
        powerKw
        maxSpeedKmH
        totalWeightTons
        numBogies
        fuelCapacityL
        gauge
    }

    class Wagon {
        type
        payloadCapacityKg
        volumeM3
        tareWeightKg
        gauge
    }

    class Train {
        name
        status
    }

    ' Relationships
    Operator "1" -- "*" Locomotive : owns
    Operator "1" -- "*" Wagon : owns
    Operator "1" -- "*" Train : manages

    Train "*" -- "*" Locomotive : uses
    Train "*" -- "*" Wagon : pulls
}

' Insfrastucture

package "Infrastructure" {

    class Station {
        name
        city
        hasWarehouse
    }

    class RailwayLine {
        name
        owner
        totalLengthKm
    }

    class LineSegment {
        lengthKm
        trackType
        gauge
        maxWeightKgPerMeter
        speedLimitKmH
        electrified
    }

    class Gauge {
        name
        measureMM
    }

    ' Relationships
    RailwayLine "1" -- "*" LineSegment : composed of
    LineSegment "1" -- "1" Station : start
    LineSegment "1" -- "1" Station : end
    Gauge "1" -- "*" LineSegment : defines
    Gauge "1" -- "*" Locomotive : supports
    Gauge "1" -- "*" Wagon : supports
}

' Freight and Routes

package "Freight and Routes" {

    class Freight {
        departureTime
        arrivalTime
        status
    }

    class FreightWagon {
        cargoDescription
        grossWeightKg
    }

    class Route {
        description
    }

    class RouteSegment {
        sequenceOrder
    }

    ' Relationships
    Freight "1" -- "*" Wagon : includes
    Freight "1" -- "*" FreightWagon : includes
    Freight "1" -- "1" Route : follows
    Freight "1" -- "1" Station : origin
    Freight "1" -- "1" Station : destination

    Wagon "1" -- "*" FreightWagon : assigned to
    Route "1" -- "*" RouteSegment : consists of
    RouteSegment "*" -- "1" LineSegment : references
    Station "1" -- "*" Freight : dispatches/receives
}

@enduml
